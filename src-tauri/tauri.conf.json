{
  "productName": "AURA-NET",
  "version": "2.0.0",
  "identifier": "com.aura.net",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../dist",
    "distDir": "../dist"
  },
  "package": {
    "productName": "AURA-NET",
    "version": "2.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": true },
      "fs": { "all": true, "scope": ["$APP/*", "$HOME/*"] },
      "network": { "all": true, "scope": ["*"] },
      "path": { "all": true },
      "protocol": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.aura.net"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "AURA-NET",
        "width": 1280,
        "height": 800
      }
    ]
  }
}
